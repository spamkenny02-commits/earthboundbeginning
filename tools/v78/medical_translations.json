[
  {
    "context": "09128D",
    "offset": "09129A",
    "end": "0912A4",
    "en": "@Who do you want to see?",
    "fr": "@Qui veux-tu voir ?"
  },
  {
    "context": "09128D",
    "offset": "0912D5",
    "end": "0912F1",
    "en": " was just brought in, and is still unconscious.",
    "fr": " vient d'arriver sans connaissance."
  },
  {
    "context": "09128D",
    "offset": "0912F5",
    "end": "0912FB",
    "en": "@Please pay $",
    "fr": "@Il faut payer $"
  },
  {
    "context": "09128D",
    "offset": "091301",
    "end": "09130E",
    "en": " for the doctor's fee.",
    "fr": " pour les soins."
  },
  {
    "context": "09128D",
    "offset": "091311",
    "end": "091314",
    "en": "Yes",
    "fr": "Oui"
  },
  {
    "context": "09128D",
    "offset": "09132E",
    "end": "091343",
    "en": "@Your friend, right?...  It's very serious.",
    "fr": "@Ton ami, c'est ça ? Son état est grave."
  },
  {
    "context": "090FEC",
    "offset": "090FF0",
    "end": "091006",
    "en": "@I can examine each one of you for $",
    "fr": "@L'examen vous coûte $"
  },
  {
    "context": "090FEC",
    "offset": "091016",
    "end": "091021",
    "en": "Yes, please",
    "fr": "Oui, merci"
  },
  {
    "context": "090FEC",
    "offset": "091024",
    "end": "09102E",
    "en": "No, thanks",
    "fr": "Non, merci"
  },
  {
    "context": "090FEC",
    "offset": "091041",
    "end": "091052",
    "en": "@You really don't need any treatment?",
    "fr": "@Tu n'as vraiment besoin d'aucun soin ?"
  },
  {
    "context": "090FEC",
    "offset": "091053",
    "end": "091058",
    "en": "  All right.",
    "fr": " D'accord."
  },
  {
    "context": "09142C",
    "offset": "09142C",
    "end": "091437",
    "en": "@I'm not busy right now.",
    "fr": "@Je suis disponible."
  },
  {
    "context": "09142C",
    "offset": "091439",
    "end": "091458",
    "en": "@Shall I explain about the hospital system?",
    "fr": "@Veux-tu savoir comment fonctionne l'hôpital ?"
  },
  {
    "context": "09142C",
    "offset": "09146D",
    "end": "091484",
    "en": "@Yeah, well, I am actually pretty busy.",
    "fr": "@Bon, en fait, j'ai du travail."
  },
  {
    "context": "0913DD",
    "offset": "0913E4",
    "end": "0913FF",
    "en": "@If you are the patient, come into the back room.",
    "fr": "@Si tu es le patient, va dans la salle du fond."
  },
  {
    "context": "0913A4",
    "offset": "0913A8",
    "end": "0913C2",
    "en": "@We don't have a person like that in our hospital.",
    "fr": "@Ce patient n'est pas dans notre hôpital."
  },
  {
    "context": "091345",
    "offset": "09137D",
    "end": "09138E",
    "en": "@I'm so glad that you recovered, ",
    "fr": "@Ça va mieux, "
  },
  {
    "context": "091345",
    "offset": "091394",
    "end": "0913A2",
    "en": "@Come back any time you need.",
    "fr": "@Reviens si tu as besoin de nous."
  },
  {
    "context": "09105F",
    "offset": "091074",
    "end": "09107D",
    "en": "@Who is sick?",
    "fr": "@Qui est malade ?"
  },
  {
    "context": "09115D",
    "offset": "091171",
    "end": "091176",
    "en": "by the way,",
    "fr": "au fait,"
  },
  {
    "context": "09115D",
    "offset": "091178",
    "end": "09119A",
    "en": "@What a sad look in your eyes... you, the boy in a red cap.",
    "fr": "@Tu as l'air triste, garçon au bonnet rouge..."
  },
  {
    "context": "09115D",
    "offset": "09119C",
    "end": "0911A8",
    "en": "@You must be homesick.",
    "fr": "@Tu dois avoir le mal du pays."
  },
  {
    "context": "09115D",
    "offset": "0911AA",
    "end": "0911C0",
    "en": "@That's nothing you need to be ashamed of.",
    "fr": "@Tu n'as pas à en avoir honte."
  },
  {
    "context": "09115D",
    "offset": "0911C2",
    "end": "0911E0",
    "en": "@Anybody who is on a long trip will miss home.",
    "fr": "@Quand on voyage longtemps, la maison nous manque."
  },
  {
    "context": "09115D",
    "offset": "0911E2",
    "end": "0911EB",
    "en": "@In this case,",
    "fr": "@Dans ce cas,"
  },
  {
    "context": "09115D",
    "offset": "0911ED",
    "end": "091212",
    "en": "@the best thing to do is to call home and hear your mom's voice.",
    "fr": "@appelle chez toi pour entendre la voix de ta maman."
  },
  {
    "context": "091ABE",
    "offset": "091ABE",
    "end": "091ACB",
    "en": "@Hey, now that I notice,",
    "fr": "@Tiens, maintenant que j'y pense,"
  },
  {
    "context": "091ABE",
    "offset": "091ACD",
    "end": "091AF0",
    "en": "@could you sell me the mushroom growing on top of your head?",
    "fr": "@Tu me vends le champignon qui pousse sur ta tête ?"
  },
  {
    "context": "091ABE",
    "offset": "091AF2",
    "end": "091B05",
    "en": "@Come on, let's make a deal.",
    "fr": "@Allez, faisons affaire."
  },
  {
    "context": "091ABE",
    "offset": "091B09",
    "end": "091B0D",
    "en": "Sell",
    "fr": "Oui"
  },
  {
    "context": "091ABE",
    "offset": "091B30",
    "end": "091B3B",
    "en": "  That's too bad.",
    "fr": " Quel dommage."
  },
  {
    "context": "091C1B",
    "offset": "091C1C",
    "end": "091C2C",
    "en": "@By the way, do you need any help?",
    "fr": "@Au fait, as-tu besoin d'aide ?"
  },
  {
    "context": "0919F6",
    "offset": "0919F6",
    "end": "091A0A",
    "en": "@Mmm, come back when necessary.",
    "fr": "@Hum, reviens si tu en as besoin."
  },
  {
    "context": "091486",
    "offset": "091486",
    "end": "0914A3",
    "en": "@If a good friend of yours becomes unconscious,",
    "fr": "@Si l'un de tes amis perd connaissance,"
  },
  {
    "context": "091486",
    "offset": "0914A5",
    "end": "0914B6",
    "en": "@come to the hospital right away.",
    "fr": "@viens à l'hôpital tout de suite."
  },
  {
    "context": "091486",
    "offset": "0914B8",
    "end": "0914D3",
    "en": "@As long as you have money for the doctor's fee,",
    "fr": "@Si tu peux payer les soins,"
  },
  {
    "context": "091486",
    "offset": "0914D5",
    "end": "0914F8",
    "en": "@you'll be able to see your friend completely recovered in no time.",
    "fr": "@ton ami sera vite sur pied."
  },
  {
    "context": "091486",
    "offset": "0914FA",
    "end": "091511",
    "en": "@Besides being unconscious, whenever",
    "fr": "@Même sans perdre connaissance, si"
  },
  {
    "context": "091486",
    "offset": "091513",
    "end": "091530",
    "en": "@you don't feel so well, come and talk to a doctor.",
    "fr": "@tu te sens mal, viens consulter un médecin."
  },
  {
    "context": "091486",
    "offset": "091532",
    "end": "091559",
    "en": "@Everything I just told you applies to hospitals all over the world.",
    "fr": "@Cela vaut pour les hôpitaux du monde entier."
  },
  {
    "context": "091401",
    "offset": "091401",
    "end": "09140F",
    "en": "@You need to be examined?",
    "fr": "@Tu veux un examen ?"
  },
  {
    "context": "091401",
    "offset": "091410",
    "end": "09142A",
    "en": "  Then, you need to see the doctor... not me.",
    "fr": " Alors, vois le médecin... pas moi."
  },
  {
    "context": "0913C4",
    "offset": "0913C4",
    "end": "0913CF",
    "en": "@You don't have enough money...?",
    "fr": "@Tu n'as pas assez d'argent ?"
  },
  {
    "context": "0913C4",
    "offset": "0913D0",
    "end": "0913DB",
    "en": "  That's too bad.",
    "fr": " Quel dommage."
  },
  {
    "context": "0910E7",
    "offset": "0910FB",
    "end": "09110E",
    "en": "@I don't think there is anything wrong with you.",
    "fr": "@Tu m'as l'air en bonne santé."
  },
  {
    "context": "091113",
    "offset": "091113",
    "end": "091125",
    "en": "@I don't think anyone has anything like that.",
    "fr": "@Personne ne semble avoir ça."
  },
  {
    "context": "091113",
    "offset": "091127",
    "end": "09113B",
    "en": "@Or Is it just my misunderstanding?",
    "fr": "@Ou ai-je mal compris ?"
  },
  {
    "context": "091140",
    "offset": "091140",
    "end": "091152",
    "en": "@I can only treat an illness.",
    "fr": "@Je ne peux soigner que les maladies."
  },
  {
    "context": "091140",
    "offset": "091153",
    "end": "091158",
    "en": "  Sorry.",
    "fr": " Désolé."
  },
  {
    "context": "091245",
    "offset": "091245",
    "end": "091254",
    "en": "@You must feel nauseous.",
    "fr": "@Tu as la nausée."
  },
  {
    "context": "091233",
    "offset": "091233",
    "end": "091240",
    "en": "@You've been poisoned.",
    "fr": "@Tu souffres d'un empoisonnement."
  },
  {
    "context": "091222",
    "offset": "091222",
    "end": "09122E",
    "en": "@You have sunstroke.",
    "fr": "@Tu as une insolation."
  },
  {
    "context": "091214",
    "offset": "091214",
    "end": "09121D",
    "en": "@You have a cold.",
    "fr": "@Tu as un rhume."
  },
  {
    "context": "091C2E",
    "offset": "091C2F",
    "end": "091C38",
    "en": "@Do you need some help?",
    "fr": "@As-tu besoin d'aide ?"
  },
  {
    "context": "091B3D",
    "offset": "091B3D",
    "end": "091B40",
    "en": "@Thanks.",
    "fr": "@OK"
  },
  {
    "context": "091B3D",
    "offset": "091B41",
    "end": "091B58",
    "en": "  I'll pay you $50 for each mushroom.",
    "fr": " Je te donne $50 par champignon."
  },
  {
    "context": "091B3D",
    "offset": "091B5A",
    "end": "091B68",
    "en": "@All right, let's do it!",
    "fr": "@D'accord, allons-y !"
  },
  {
    "context": "38B206",
    "offset": "38B22B",
    "end": "38B231",
    "en": "Soften",
    "fr": "Dépétrifier"
  },
  {
    "context": "38B206",
    "offset": "38B234",
    "end": "38B243",
    "en": "Restore feeling",
    "fr": "Sensibilité"
  },
  {
    "context": "38B206",
    "offset": "38B246",
    "end": "38B24C",
    "en": "Purify",
    "fr": "Purifier"
  },
  {
    "context": "38B206",
    "offset": "38B24F",
    "end": "38B256",
    "en": "Refresh",
    "fr": "Revigorer"
  },
  {
    "context": "38B206",
    "offset": "38B27F",
    "end": "38B296",
    "en": "@I need to charge you $",
    "fr": "@Cela te coûtera donc $"
  },
  {
    "context": "091259",
    "offset": "09126F",
    "end": "091277",
    "en": "@You're all well now.",
    "fr": "@Tu vas mieux !"
  },
  {
    "context": "091259",
    "offset": "091278",
    "end": "091288",
    "en": "  What a great doctor I am!",
    "fr": " Quel bon médecin je suis !"
  },
  {
    "context": "0918BE",
    "offset": "0918BF",
    "end": "0918D3",
    "en": "@Mmm, come back when necessary.",
    "fr": "@Hum, reviens si tu en as besoin."
  },
  {
    "context": "091A11",
    "offset": "091A12",
    "end": "091A40",
    "en": "@If you don't have any money, you'll just have to keep on going in your current state.",
    "fr": "@Sans argent, tu devras continuer dans cet état."
  },
  {
    "context": "0918F7",
    "offset": "0918F7",
    "end": "091905",
    "en": "@Who needs healing?",
    "fr": "@Qui faut-il soigner ?"
  },
  {
    "context": "0919B5",
    "offset": "0919BE",
    "end": "0919C9",
    "en": " isn't possessed.",
    "fr": " n'est pas sous emprise."
  },
  {
    "context": "091A51",
    "offset": "091A61",
    "end": "091A73",
    "en": "@There!  You're already healed!",
    "fr": "@Voilà ! Les soins sont terminés !"
  },
  {
    "context": "091A51",
    "offset": "091A74",
    "end": "091A8A",
    "en": "  Can I do my job well, or what!",
    "fr": " Je fais du bon travail, hein !"
  },
  {
    "context": "09199E",
    "offset": "0919A7",
    "end": "0919B0",
    "en": " isn't numb.",
    "fr": " ne souffre pas d'engourdissement."
  },
  {
    "context": "0919CE",
    "offset": "0919DA",
    "end": "0919EA",
    "en": "  Who needs to be healed?",
    "fr": " Qui faut-il soigner ?"
  }
]
