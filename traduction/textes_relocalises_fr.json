      "text_fr_segments": [
        {
          "offset": 35,
          "end": 113,
          "original": "@Citizen, I know it's a lot, but your town needs promising young men like you.",
          "french": "@Citoyen, je sais que c'est beaucoup, mais notre ville a besoin de jeunes prometteurs comme toi."
        },
        {
          "offset": 115,
          "end": 126,
          "original": "@You see...",
          "french": "@Tu vois..."
        },
        {
          "offset": 128,
          "end": 167,
          "original": " a child has strayed into the cemetery.",
          "french": " une enfant s'est égarée dans le cimetière."
        },
        {
          "offset": 169,
          "end": 211,
          "original": "@And, I'm going up for re-election soon...",
          "french": "@Et je me présente bientôt aux élections..."
        },
        {
          "offset": 213,
          "end": 217,
          "original": "@...",
          "french": "@..."
        },
        {
          "offset": 219,
          "end": 234,
          "original": "@You must help!",
          "french": "@Tu dois nous aider !"
        },
        {
          "offset": 237,
          "end": 254,
          "original": "  Please help me!",
          "french": "  Aide-moi, je t'en prie !"
        },
        {
          "offset": 257,
          "end": 260,
          "original": "Yes",
          "french": "Oui"
        },
        {
          "offset": 263,
          "end": 265,
          "original": "No",
          "french": "Non"
        },
        {
          "offset": 281,
          "end": 286,
          "original": "@Oh?!",
          "french": "@Oh ?!"
        },
        {
          "offset": 288,
          "end": 319,
          "original": "  You'll go there and save her?",
          "french": "  Tu vas aller la sauver ?"
        },
        {
          "offset": 321,
          "end": 338,
          "original": "@Come back alive,",
          "french": "@Reviens vivant,"
        },
        {
          "offset": 340,
          "end": 369,
          "original": " and surely you'll be a hero!",
          "french": " et tu seras un vrai héros !"
        },
        {
          "offset": 371,
          "end": 406,
          "original": "@If only I was, er, feeling better,",
          "french": "@Si seulement je me sentais mieux,"
        },
        {
          "offset": 408,
          "end": 432,
          "original": " I'd, um, go with you...",
          "french": " euh, je viendrais avec toi..."
        },
        {
          "offset": 434,
          "end": 441,
          "original": " *Ahem*",
          "french": " *Hum*"
        },
        {
          "offset": 443,
          "end": 451,
          "original": " *cough*",
          "french": " *tousse*"
        }
      ]
    },
