      "evidence": "Entrée de quête 360038 -> F601FC ; remplace le candidat décalé 3601F7.",
      "text_fr_segments": [
        {
          "offset": 3,
          "end": 37,
          "original": "@Oh, is this the lost girl, Pippi?",
          "french": "@Oh, c'est Pippi, la fille qui avait disparu ?"
        },
        {
          "offset": 39,
          "end": 64,
          "original": "@Well, that's just great!",
          "french": "@Quelle bonne nouvelle !"
        },
        {
          "offset": 67,
          "end": 107,
          "original": "  I knew you'd be a promising young man.",
          "french": "  Je savais que tu étais un jeune plein d'avenir."
        },
        {
          "offset": 109,
          "end": 122,
          "original": "  *Applause* ",
          "french": "  *Bravo* "
        },
        {
          "offset": 124,
          "end": 134,
          "original": "*applause*",
          "french": "*bravo*"
        },
        {
          "offset": 136,
          "end": 169,
          "original": "@What a relief, eh, pretty Pippi?",
          "french": "@Quel soulagement, ma jolie Pippi !"
        },
        {
          "offset": 171,
          "end": 237,
          "original": "@Now, don't forget to tell your mother that the mayor rescued you.",
          "french": "@N'oublie pas de dire à ta maman que c'est le maire qui t'a sauvée."
        },
        {
          "offset": 239,
          "end": 252,
          "original": "@As for you, ",
          "french": "@Quant à toi, "
        },
        {
          "offset": 255,
          "end": 258,
          "original": "...",
          "french": "..."
        },
        {
          "offset": 262,
          "end": 296,
          "original": "@I'll give you this prize of $100.",
          "french": "@Voici ta récompense de 100 dollars."
        },
        {
          "offset": 323,
          "end": 375,
          "original": "@By the way, hero... while you're at it, you know...",
          "french": "@Au fait, héros... tant que tu y es..."
        },
        {
          "offset": 377,
          "end": 431,
          "original": "@Maybe you'd also like to go see what's up at the zoo?",
          "french": "@Veux-tu aussi voir ce qui se passe au zoo ?"
        },
        {
          "offset": 435,
          "end": 438,
          "original": "Yes",
          "french": "Oui"
        },
        {
          "offset": 441,
          "end": 443,
          "original": "No",
          "french": "Non"
        },
        {
          "offset": 459,
          "end": 494,
          "original": "@Yes, I knew you would agree to go!",
          "french": "@Je savais que tu accepterais !"
        },
        {
          "offset": 496,
          "end": 518,
          "original": "  Great, great, great!",
          "french": "  Parfait, parfait, parfait !"
        },
        {
          "offset": 520,
          "end": 573,
          "original": "@You really like playing games like that, don't you, ",
          "french": "@Tu aimes vraiment jouer à ces jeux, hein, "
        },
        {
          "offset": 581,
          "end": 582,
          "original": ".",
          "french": "."
        },
        {
          "offset": 584,
          "end": 652,
          "original": "@Now, make sure to get the key to the zoo from my assistant, Abbott.",
          "french": "@Va chercher la clé du zoo auprès de mon adjoint, Abbott."
        }
      ]
    },
